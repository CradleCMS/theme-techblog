<div class="index-hero">
  <div class="hero-content">
    <div class="hero-text{{ settings.indexOtfCardBg | def:'bg-0' }}{% if settings.indexOtfPos == "center" %} text-center{% endif %}">
      {% if settings.indexOtfTitle %}
        <h1>{{ settings.indexOtfTitle | t }}</h1>
      {% endif %}
      {% if settings.indexOtfText %}
        <p>{{ settings.indexOtfText | t }}</p>
      {% endif %}
      {% if settings.indexOtfBtnUrl %}
        <a class="btn" href="{{ settings.indexOtfBtnUrl }}">{{ settings.indexOtfBtnText | t }}</a>
      {% endif %}
    </div>
    {% if settings.indexOtfFgimg != blank %}
        <figure>
            <img src="{{ settings.indexOtfFgimg | asset_img_url:450,0 }}" alt="{{ settings.indexOtfFgimgAlt | t }}">
        </figure>
    {% endif %}
  </div>
</div>